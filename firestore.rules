rules_version = '2';

// firestore.rules v1.1.0 — TypeThatBook
// v1.1.0 — building_admin role; per-person readScope; class-scoped activity reads
//          via claim.classIds; teachers can no longer edit a colleague's class
//          (which under 'own_classes' scope was a self-service escalation).
//
// ⚠️ THERE ARE CURRENTLY NO RULES DEPLOYED (or they're console-only and not in
//    version control). Until this file is live, ANY signed-in user can read ANY
//    student's data. That was a latent risk with one adult on the project. With
//    colleagues in other buildings it is the thing holding the whole model up.
//
// ── MODEL ──
// No claim at all = a student. That's the default for anyone who signs in, and
// it needs no configuration.
//
//   teacher         — read scope is a PER-PERSON setting, not a property of the
//                     role. `readScope: 'own_classes'` (the default) or
//                     'building', chosen by their building_admin. Writes: only
//                     classes they teach.
//   building_admin  — reads their whole building. Writes any class in it, and
//                     manages teachers in it (including their readScope).
//   super_admin     — everything. NOT grantable through the app; use the
//                     bootstrap list in functions/index.js or the console.
//
// ── HOW SCOPE IS ENFORCED FOR FREE ──
// 'building' scope reads `schoolId` straight off the document — it's denormalised
// onto every typing_logs and typing_sessions doc (game.js v3.4.0), so the check
// costs nothing.
//
// 'own_classes' scope checks `classId` against a list carried IN THE CLAIM. Also
// free. The alternative — get()-ing the class doc per access — would be billed as
// a read every time. A classId is ~10 bytes against a ~1000 byte claim budget, so
// a teacher with 60 classes still fits.
//
// ── THE CONSEQUENCE WORTH KNOWING ──
// claim.classIds is derived from classes that list the person in `teacherUids`.
// So when a teacher creates a class, their claim is STALE until they call
// syncMyClaims() and refresh their token — otherwise they can't read the class
// they just made. staff-admin.js and the CSV import path both do this
// automatically; if you add another class-creation route, it must too.
//
// ── CLAIMS ──
// role and schoolIds live in Firebase Auth CUSTOM CLAIMS, not in a Firestore
// field the client reads. Claims are signed by Google, arrive inside the auth
// token, and cost zero reads to check. A student editing devtools cannot grant
// themselves anything.
//
//   { role: 'teacher' | 'super_admin', schoolIds: ['ems', 'hms'] }
//
// classIds are NOT in the claim — they change every trimester and claims have a
// 1000-byte budget. They live in staff/{uid} and drive the UI's default scope.
//
// Claims are baked in at sign-in. After a role change the user needs
// getIdToken(true) or a fresh sign-out/in. See setStaffRole in functions/index.js.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── helpers ───────────────────────────
    // NOTE: signedIn() is TRUE for Firebase Anonymous Auth users. That is
    // intentional — game.js lets students play anonymously and they must be able
    // to read books, chapters, and settings/goals. Anonymous users never write
    // typing_logs (game.js flushAll() returns early for them), so nothing
    // untracked gets recorded. Do not "tighten" this to require a non-anonymous
    // provider without checking game.js first; it will break anonymous play.
    function signedIn()  { return request.auth != null; }
    function claims()    { return request.auth.token; }
    function isStaff()   { return signedIn() && claims().role is string; }
    function isSuper()   { return isStaff() && claims().role == 'super_admin'; }
    function isBldgAdmin() { return isStaff() && claims().role == 'building_admin'; }

    function mySchools() {
      return claims().schoolIds is list ? claims().schoolIds : [];
    }
    function myClasses() {
      return claims().classIds is list ? claims().classIds : [];
    }
    // Absent readScope means the tightest option, not the loosest.
    function readsWholeBuilding() {
      return isSuper() || isBldgAdmin() ||
             (isStaff() && claims().readScope == 'building');
    }

    // Can the caller act on data belonging to this building?
    function inMySchool(sid) {
      return isSuper() || (isStaff() && sid is string && sid in mySchools());
    }

    // May the caller read this student-activity document? `d` is resource.data.
    // Building scope checks the doc's schoolId; class scope checks its classId
    // against the claim. Both are free — no get(), no billed reads.
    function canReadActivity(d) {
      return isSuper()
          || (readsWholeBuilding() && d.schoolId is string && d.schoolId in mySchools())
          || (isStaff() && d.classId is string && d.classId in myClasses());
    }

    // Does the caller teach this class? Used to stop a teacher from adding
    // themselves to a colleague's class, which under 'own_classes' scope would
    // otherwise be a way to widen their own access.
    function teachesClass(classId, d) {
      return isStaff() && (classId in myClasses() ||
             (d.teacherUids is list && request.auth.uid in d.teacherUids));
    }

    // ─────────────────────────── students ───────────────────────────
    // A student owns their own subtree outright.
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
      // Building-scoped for ALL staff, including 'own_classes' teachers — not an
      // oversight. This document holds only classId and schoolId, no identifying
      // information, and a teacher needs to read it to build a roster (which
      // class is this student in?). Narrowing it would break roster management to
      // protect two non-identifying fields.
      allow read: if isSuper() || (isStaff() && inMySchool(resource.data.schoolId));
    }

    // reports.html lets an admin CORRECT a student's recorded time (the
    // "adjust seconds" control). That's a write to a student's stats doc, so
    // staff need more than read here.
    //
    // Subcollection documents don't carry schoolId, so scoping needs a get() on
    // the parent — which is billed as a read. Paying it here is fine: this is a
    // deliberate admin correction performed a handful of times a day, not a hot
    // path. Contrast typing_logs below, where the same check is free because
    // schoolId is denormalised onto the document.
    match /users/{uid}/stats/{docId} {
      allow read, write: if request.auth.uid == uid;
      // Only building-scoped staff may correct times. A teacher restricted to
      // their own classes would need a class lookup here, and this path already
      // pays for a get() — two would be worse. Corrections are an admin action;
      // routing them through a building_admin is reasonable.
      allow read, write: if isSuper() || (readsWholeBuilding() && inMySchool(
        get(/databases/$(database)/documents/users/$(uid)).data.schoolId));
    }

    // Everything else under a student — progress, profile, lessonProgress.
    // Read-only for staff, same get()-based scoping.
    match /users/{uid}/{collection}/{docId} {
      allow read, write: if request.auth.uid == uid;
      allow read: if isSuper() || (isStaff() && inMySchool(
        get(/databases/$(database)/documents/users/$(uid)).data.schoolId));
    }

    // ─────────────────────────── activity logs ───────────────────────────
    // Doc ID is `{uid}_{YYYY-MM-DD}`, which is what enforces "students write
    // only their own log" without needing to read the existing document.
    match /typing_logs/{docId} {
      allow create, update: if signedIn()
                            && docId.split('_')[0] == request.auth.uid
                            && request.resource.data.uid == request.auth.uid;
      allow read:   if canReadActivity(resource.data);
      allow delete: if isSuper();
    }

    match /typing_sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if canReadActivity(resource.data);
      allow update, delete: if isSuper();
    }

    // These carry email, displayName, and the full generated paragraph, so they
    // get the same scoping as any other activity data. game.js v3.4.2 added the
    // classId/schoolId stamps that make that possible — before it, the only
    // available rule was "any staff member anywhere", which was a leak.
    //
    // Documents written before v3.4.2 have no stamps and are therefore readable
    // by nobody but a super_admin. That's the right way round for a fallback.
    match /practice_sessions/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read:   if canReadActivity(resource.data);
      allow update, delete: if isSuper();
    }

    // Rate-limit counters are written by the Cloud Function using the Admin SDK,
    // which bypasses rules entirely. No client should ever touch these.
    match /practice_limits/{uid} {
      allow read, write: if false;
    }

    // ─────────────────────────── leaderboard ───────────────────────────
    // Public to signed-in students by design. Contains initials only — real
    // names were removed in game.js v3.3.0 precisely because of this rule.
    match /leaderboard/{uid} {
      allow read:   if signedIn();
      allow create, update: if request.auth.uid == uid || isStaff();
      allow delete: if isSuper();
    }

    // ─────────────────────────── org structure ───────────────────────────
    match /schools/{schoolId} {
      allow read:  if signedIn();          // students need their building's name
      allow write: if isSuper();
    }

    // Staff records are readable by staff (so reports can resolve names) and
    // writable only by a super_admin. A teacher must NOT be able to grant
    // themselves a school — that's the whole security boundary.
    // Staff records are written ONLY by the Cloud Functions (Admin SDK bypasses
    // rules), never by a client. That's what guarantees a claim can't disagree
    // with its record: pushClaims() is the only writer of both.
    match /staff/{uid} {
      allow read:  if isStaff() || request.auth.uid == uid;
      allow write: if false;
    }

    match /classes/{classId} {
      // Students read their own class for goals. Cheap and harmless — a class doc
      // holds a name and two goal numbers.
      allow read: if signedIn();

      // Teachers create classes in their own building only. Checking
      // request.resource on create and resource on update is the standard split:
      // on create there's no existing doc to read a schoolId from.
      // Creating: must be in your building, and you must put yourself on it.
      // Without that second clause a teacher could create classes they can't
      // then read, which is just confusing.
      allow create: if isSuper() || isBldgAdmin() && inMySchool(request.resource.data.schoolId)
                    || (isStaff()
                        && inMySchool(request.resource.data.schoolId)
                        && request.resource.data.teacherUids is list
                        && request.auth.uid in request.resource.data.teacherUids);

      // Updating: a building_admin may edit any class in their building. A plain
      // teacher may edit only classes they already teach — otherwise, under
      // 'own_classes' read scope, adding yourself to a colleague's class would be
      // a self-service way to widen your own access.
      allow update: if isSuper()
                    || (isBldgAdmin() && inMySchool(resource.data.schoolId)
                                      && inMySchool(request.resource.data.schoolId))
                    || (isStaff() && teachesClass(classId, resource.data)
                                  && inMySchool(resource.data.schoolId)
                                  && inMySchool(request.resource.data.schoolId));

      allow delete: if isSuper()
                    || (isBldgAdmin() && inMySchool(resource.data.schoolId))
                    || (isStaff() && teachesClass(classId, resource.data)
                                  && inMySchool(resource.data.schoolId));
    }

    // Roster pre-assignment: keyed by student email, consumed by the student on
    // first sign-in (learn.js applyPendingClassAssignment deletes it as the
    // student, which is why delete is allowed to the owner).
    match /pendingClassAssignments/{email} {
      allow read, delete: if isStaff() || (signedIn() && claims().email == email);
      allow create, update: if isStaff();
    }

    // ─────────────────────────── content ───────────────────────────
    match /books/{bookId} {
      allow read:  if signedIn();
      allow write: if isSuper();
      match /chapters/{chapterId} {
        allow read:  if signedIn();
        allow write: if isSuper();
      }
    }

    match /lessons/{lessonId} {
      allow read:  if signedIn();
      allow write: if isSuper();
    }

    match /settings/{docId} {
      allow read:  if signedIn();
      allow write: if isSuper();
    }

    // ─────────────────────────── default deny ───────────────────────────
    // Firestore already denies anything no rule allows, so this block grants
    // nothing new — rules are permissive-OR and a catch-all `if false` cannot
    // override a more specific allow above. It's here as documentation: adding a
    // collection means adding a rule, because the default is deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
