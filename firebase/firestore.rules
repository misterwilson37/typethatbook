rules_version = '2';

// firestore.rules v2.8.0 — TypeThatBook
//
// v2.8.0 — ⚠️⚠️ THE typing_sessions OWNER MAY NOW UPDATE, UNDER THE SAME
//          VALIDATION AS create. ROADMAP item 24: session-log.js v1.7.0 makes
//          the queue flush IDEMPOTENT — a resent chunk derives the same
//          document id and calls setDoc() to overwrite it rather than
//          addDoc()'s random-id append. Without this rule change that resend
//          is DENIED (`update` was `isSuper()`-only) and retries forever,
//          which is exactly the failure the app-side fix cannot see from the
//          browser — it would look shipped and do nothing. ⚠️ MUST DEPLOY IN
//          THE SAME ROUND AS session-log.js v1.7.0 / game.js v3.46.0 /
//          learn.js v2.38.0, same reasoning as v2.7.0's note above about a
//          feature that fails silently on a rarely-hit path.
//
//          ⚠️ SAME OWNERSHIP AND FIELD CHECKS AS create, not a bare
//          `isOwner()`. A resend recomputes the whole payload from the
//          current queue, so `update` is really "create, again" here — the
//          size/seconds/expiresAt clamps exist to stop a forged value and a
//          resend is not exempt from them just because the document already
//          exists. `delete` stays `isSuper()`-only; nothing in the app ever
//          deletes one of these, and this round is not the round to open
//          that door.
//
// v2.7.0 — ⚠️⚠️ BUILDING-SCOPED STAFF MAY NOW WRITE lessonProgress, AND ONLY
//          lessonProgress. ROADMAP 15's grade-reconstruction button (the ⚑ on
//          each daily-log row in reports.html) writes runGrades/runFires back
//          onto a STUDENT'S record, and the rule here was `request.auth.uid ==
//          uid` with NO STAFF BRANCH AT ALL — so the feature would have failed
//          permission-denied for every student except Jake's own account, which
//          is the one account that never needed it.
//
//          ⚠️ MUST DEPLOY, AND THE BUTTON IS INERT UNTIL YOU DO. Unlike v2.6.0
//          this is not a fix to a live symptom — nothing is broken today — but
//          reports.html v1.1.0 ships in the same round and its new button does
//          nothing at all until this publishes. It fails as a console warning on
//          a rarely-used button, which is precisely how the typing_logs update
//          rule stayed silently broken for several versions (see v2.2.0's note
//          at match /typing_logs).
//
//          ⚠️ SCOPED NARROWER THAN THE READ RULE BESIDE IT, ON PURPOSE. It names
//          lessonProgress explicitly rather than reusing the four-name
//          whitelist: nothing in the app needs staff writing a student's
//          `profile`, `progress` or `stats`, and a wildcard there would hand
//          every teacher a write path to all four. Mirrors the /stats rule —
//          super, or staff who read the whole building AND are in that student's
//          building.
//
//          ⚠️ EXECUTED, NOT REASONED ABOUT. `npm run test:rules` covers this with
//          7 new cases, 4 of them NEGATIVE (a teacher may not reach `profile` or
//          `progress`; a student may not reach another student's record).
//          HANDOFF §0.-5.A is the round that skipped those nine seconds.
//          See the block comment at match /users/{uid}/{collection} for the rest.
//
// v2.6.0 — ⚠️⚠️⚠️ A READ OF A DAY THE STUDENT DID NOT TYPE WAS BEING DENIED, AND
//          IT BROKE EVERY STUDENT'S WEEK. `resource` is null on a get() of a
//          document that does not exist; v2.5.0's owner clause dereferenced it;
//          an error denies. daylog.js reads seven days and gives up if any one
//          fails, and every week contains a weekend. So the owner-read that
//          v2.5.0 shipped to END the two-number problem never once succeeded.
//
//          ⚠️ IT WAS NOT VISIBLE AS AN ERROR. The student's page falls back to
//          a live counter, so the number on screen looked plausible — it was
//          just their current tab instead of their week. Found on 2026-08-20
//          only because Jake asked why a child's week equalled her day.
//
//          ⚠️ DEPLOY THIS BEFORE ANY FURTHER APP CODE. It needs no code deploy
//          of its own, it is a Rules-editor paste, and it fixes the visible
//          symptom for every student the moment it publishes. The game.js and
//          learn.js work for §3.1 assumes a week read that WORKS; shipping that
//          onto this rule would only move where the wrongness lives.
//          See the block comment at match /typing_logs for the full account.
//
// v2.5.0 — ⚠️ THE OWNER MAY NOW READ THEIR OWN typing_logs AND typing_sessions.
//          This is a PREREQUISITE, not a feature. It is deployed ahead of the
//          code that uses it because it is safe standing alone: it widens read
//          to the one person the document is already about, and nothing in the
//          app reads those paths as a student yet.
//
//          ⚠️ WHY IT MATTERS MORE THAN IT LOOKS. Until this version, a STUDENT'S
//          BROWSER WAS STRUCTURALLY FORBIDDEN FROM READING EITHER RECORD THE
//          TEACHER GRADES FROM. `allow read: if canReadActivity(...)` is
//          staff-only on both. That is the ROOT CAUSE of the two-number problem
//          that has cost this project five rounds: the HUD could not read the
//          graded document, so it had no choice but to keep a private second
//          copy in users/{uid}/stats/time_tracking, accumulated separately and
//          flushed on a different schedule. Two records of one quantity, updated
//          on different paths, disagreeing — HANDOFF §3.1's sentence, and this
//          rule is why it was unavoidable rather than careless.
//
//          With this deployed, the HUD can read typing_logs/{uid}_{date} BY
//          DOCUMENT ID — the id is uid + '_' + date, so a week is seven getDoc()
//          calls, no query, NO COMPOSITE INDEX, and no change to the field
//          exemptions in firestore.indexes.json. The student's screen and the
//          teacher's report can then be reading THE SAME DOCUMENT, which is the
//          only arrangement in which they cannot disagree.
//
//          Scoped to the owner only: `resource.data.uid == request.auth.uid`.
//          No student can see another student's anything. Staff access is
//          unchanged in both directions.
//
// v2.4.0 — validDailyLog() accepts the new split-field shape (secondsLibrary/
//          secondsSchool etc., alongside the legacy seconds/chars/mistakes)
//          so game.js v3.29.0 / learn.js v2.14.0's per-source typing_logs
//          fields validate. See that function's own comment. This is a
//          MUST-DEPLOY-BEFORE change: without it, every student's very first
//          flush of a new day is a brand-new document containing only the
//          split fields, and the OLD rule required the legacy `seconds` field
//          to exist — that write would be rejected outright, silently, the
//          same failure mode the "NO keys().hasOnly()" note above already
//          warned about. Deploy this rules change before uploading the new
//          game.js/learn.js, not after.
//
// v2.3.0 — GUEST READ on content. books, books/*/chapters, lessons and
//          settings/goals are now world-readable. Everything else is unchanged.
//
//          Why: every student-facing page was already written to work with no
//          user. game.js has an explicit signed-out branch ("just load the book
//          as read-only"), learn.js has a signed-out branch plus an anonymous
//          nudge and a retroactive-save path, and there are 29 sites across the
//          two files guarding writes with `!currentUser || currentUser.isAnonymous`.
//          None of it ever ran, because THESE RULES were the only thing in the
//          way: a guest is `request.auth == null`, `signedIn()` was false, and
//          the content reads came back permission-denied. The feature was built
//          and never switched on, and the switch was here.
//
//          ⚠️ Public read means unmetered reads billed to Jake's card. Two
//          things hold that down and both already exist: the client-side caches
//          in index.html / learn.js (a count aggregation validates a 6-hour
//          book cache for ONE billed read), and App Check, which is wired in
//          firebase-config.js v1.2.0 but NOT ENFORCED — that is a console click
//          (App Check → APIs → Enforce). Read firebase-config.js's App Check
//          block before clicking it; a district content filter that blocks
//          recaptcha paths turns enforcement into a total outage.
//
//          ⚠️ settings is SPLIT rather than opened. settings/goals is the daily
//          and weekly minute target and every student reads it. settings/
//          languageFilter is Jake's curated list of flagged words. Opening the
//          whole collection would publish that list to the internet for no
//          reason, so the read is keyed on the document id.
//
// v2.2.0 — Write validation on the three activity collections, and the
//          users/{uid}/{collection} wildcard restricted to a whitelist.
//          Before this, any signed-in Google account could write unbounded
//          documents into the database and any student could forge their own
//          graded minutes. Neither required an exploit — just the console.
//          See the block comments at each match; the reasoning is the point.
//
// v2.1.0 — pendingStaffRoles: grant a role to an email address before that person
//          has ever signed in. Their first sign-in converts it to a staff record.
//          Also: all allow-statements collapsed into single || expressions with the
//          cheapest condition first, so a student write can never evaluate a get().
//          See "COST" below — this matters at 7,000 students.
// v2.0.0 — Roles moved from Auth custom claims into Firestore documents, so the
//          whole system deploys with no command line.
//
// ⚠️ THERE ARE NO RULES DEPLOYED UNTIL YOU PASTE THIS IN. Without them, any signed
//    in user can read any student's data.
//
// Designed to need no command line. Roles live in Firestore documents that these
// rules read directly. (Auth custom claims would have been marginally cheaper, but
// claims can only be written by the Admin SDK, which means deploying Cloud
// Functions, which means a terminal.)
//
// Two consequences, both good:
//   1. Role changes take effect immediately — rules read the live document on every
//      request. No "sign out and back in."
//   2. One copy of the truth, so nothing can drift out of sync.
//
// The cost: rules get() the caller's staff document, which is billed as a read.
// Firestore caches repeats within a request, so it's roughly one extra read per
// request, and only on admin pages — never on a student's.
//
// ── MODEL ──
// No staff document = a student. That's the default for anyone who signs in.
//
//   teacher         — readScope is a PER-PERSON setting: 'own_classes' (default)
//                     or 'building', chosen by their building_admin.
//                     Writes: only classes whose teacherUids already include them.
//   building_admin  — reads their whole building; edits any class in it; grants
//                     and adjusts teachers in it.
//   super_admin     — everything, including books, lessons, settings, and other
//                     admins. Grantable only by editing staff/{uid} directly in
//                     the Firebase console — see SETUP-NO-CLI.md.

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── helpers ───────────────────────────
    // ⚠️ THE OLD COMMENT HERE WAS FALSE AND IT COST A ROUND TO FIND OUT.
    // It read: "signedIn() is TRUE for Firebase Anonymous Auth users.
    // Intentional — game.js lets students play anonymously and they must be able
    // to read books, chapters, and settings/goals." Every clause of that is true
    // EXCEPT the premise. `signInAnonymously` is not called anywhere in this
    // repo — not in game.js, not in learn.js, not in index.html, not in
    // firebase-config.js. No user has ever been anonymous. A guest is
    // `request.auth == null`, signedIn() was false, and guests could read
    // nothing. Guest access is granted by the `allow read: if true` on the
    // content matches below, not by this function.
    //
    // ⚠️ IF YOU EVER DO ENABLE ANONYMOUS AUTH, DO NOT DO IT WITHOUT AUDITING
    // THIS FILE FIRST. Flipping that console toggle makes signedIn() true for
    // the entire internet, which silently widens SIX grants that have nothing
    // to do with reading a book:
    //     leaderboard        read (student initials) AND create/update for own uid
    //     typing_logs        create + update
    //     typing_sessions    create
    //     practice_sessions  create
    //     schools            read
    //     classes            read
    //     staffRequests      create
    // The client-side `isAnonymous` guards do not help — rules are the security
    // boundary and the client is not. Anonymous auth is a strictly larger change
    // than public content read, and it is the one that needs an isRealUser()
    // helper (`request.auth.token.firebase.sign_in_provider != 'anonymous'`)
    // threaded through all six. Public read on four content paths widens exactly
    // what it says and nothing else.
    function signedIn() { return request.auth != null; }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function hasStaffDoc() {
      return signedIn() &&
             exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    // Every staff check funnels through here so an inactive record is dead
    // everywhere at once.
    function isStaff() {
      return hasStaffDoc() && staffDoc().active == true &&
             staffDoc().role in ['teacher', 'building_admin', 'super_admin'];
    }
    function isSuper()     { return isStaff() && staffDoc().role == 'super_admin'; }
    function isBldgAdmin() { return isStaff() && staffDoc().role == 'building_admin'; }
    function isAdmin()     { return isSuper() || isBldgAdmin(); }

    function mySchools() {
      return staffDoc().schoolIds is list ? staffDoc().schoolIds : [];
    }
    // Class membership is read from the CLASS document, not from a list on the
    // staff record. That's deliberate and it removes a whole category of bug:
    // there is nothing to keep in sync. A teacher can only create a class with
    // themselves on it, and can only edit a class they're already on, so
    // teacherUids is self-maintaining and can't be used to widen their own scope.
    //
    // Costs a get() on the class document, cached per request. For a report scoped
    // to one class that's a single extra read.
    function teachesClass(classId) {
      return classId is string
             && exists(/databases/$(database)/documents/classes/$(classId))
             && get(/databases/$(database)/documents/classes/$(classId))
                  .data.teacherUids is list
             && request.auth.uid in
                get(/databases/$(database)/documents/classes/$(classId)).data.teacherUids;
    }
    // Absent readScope means the tightest option, never the loosest.
    function readsWholeBuilding() {
      return isSuper() || isBldgAdmin() || staffDoc().readScope == 'building';
    }
    // ── Pre-authorisation by email ──
    // A role can be granted to someone who has NEVER signed in. There's no UID to
    // key a staff record on yet, so an admin writes pendingStaffRoles/{email}
    // instead, and the person's own first sign-in converts it into their staff
    // record. Same pattern as pendingClassAssignments, which already works this
    // way for student rosters.
    //
    // The pending document IS the authorisation. A user may create their own staff
    // record only if it matches one exactly — they cannot invent a role, and they
    // cannot edit the record afterwards (no self-edit, see match /staff).
    function pendingRolePath() {
      return /databases/$(database)/documents/pendingStaffRoles/$(request.auth.token.email);
    }
    function hasPendingRole() {
      return signedIn() && request.auth.token.email is string
             && exists(pendingRolePath());
    }
    function pendingRole() { return get(pendingRolePath()).data; }

    function matchesPendingRole() {
      return hasPendingRole()
             && request.resource.data.role == pendingRole().role
             && request.resource.data.schoolIds == pendingRole().schoolIds
             && request.resource.data.readScope == pendingRole().readScope
             && request.resource.data.active == true;
    }

    function inMySchool(sid) {
      return isSuper() || (isStaff() && sid is string && sid in mySchools());
    }

    // May the caller read this student-activity document? `d` is resource.data.
    function canReadActivity(d) {
      return isSuper()
          || (isStaff() && readsWholeBuilding()
                        && d.schoolId is string && d.schoolId in mySchools())
          || (isStaff() && teachesClass(d.classId));
    }

    // ─────────────────────────── students ───────────────────────────
    match /users/{uid} {
      // Writes here are once-per-session at most, so this block is about
      // correctness rather than read cost. The genuinely hot paths — stats and
      // progress — are below and each use a single || expression so a student's
      // flush can never trigger a billed get().
      //
      // update and create are split deliberately: diff() needs an existing
      // `resource`, so using `allow write` here would error on create.
      allow update: if request.auth.uid == uid
        // Staff assign a student to a class (CSV import, Add One Student). THIS
        // WAS MISSING and would have denied both outright — the audit's main find.
        // Restricted to two fields; a teacher has no business rewriting anything
        // else in a student's document, and hasOnly() is what enforces it.
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['classId', 'schoolId'])
            && (inMySchool(resource.data.schoolId)
                || !('schoolId' in resource.data)
                || resource.data.schoolId == ''));

      // Assigning a student who exists in Auth but has never had a user document.
      allow create: if request.auth.uid == uid
        || (isStaff()
            && request.resource.data.keys().hasOnly(['classId', 'schoolId'])
            && inMySchool(request.resource.data.schoolId));

      allow delete: if request.auth.uid == uid || isSuper();

      // Holds only classId and schoolId — no identifying information — and a
      // teacher needs it to build a roster.
      //
      // UNASSIGNED students (no schoolId yet) are readable by any staff. That's
      // the second audit find: scoping strictly by schoolId meant nobody could see
      // the students who most needed assigning, because a student has no schoolId
      // until they're put in a class that has one. Chicken-and-egg.
      allow read: if request.auth.uid == uid
        || (isStaff() && (inMySchool(resource.data.schoolId)
                          || !('schoolId' in resource.data)
                          || resource.data.schoolId == ''));
    }

    // reports.html lets staff CORRECT a student's recorded time. Only
    // building-scoped staff may; a class-scoped teacher should route corrections
    // through their building admin.
    // ⚠️ HOTTEST PATH IN THE APP. game.js and learn.js both write this on every
    // flush. The self-check must be first AND in the same || expression: Firestore
    // short-circuits ||, but does not promise to skip a second, separate
    // allow-statement. As two statements this risked a get() on every student's
    // every flush — thousands of reads a day, for nothing.
    match /users/{uid}/stats/{docId} {
      allow read, write: if request.auth.uid == uid
        // Only building-scoped staff may correct times (reports.html). A
        // class-scoped teacher routes corrections through their building admin:
        // subcollection docs carry no schoolId, so scoping needs a get(), and one
        // is enough to pay for on a path this rare.
        || isSuper()
        || (isStaff() && readsWholeBuilding() && inMySchool(
              get(/databases/$(database)/documents/users/$(uid)).data.schoolId));
    }

    // progress, profile, lessonProgress. Also a hot student path — same
    // single-expression, self-check-first discipline as stats above.
    //
    // ⚠️ v2.2.0 — THE COLLECTION NAME IS NOW WHITELISTED. `{collection}` is a
    // wildcard, so `allow write: if request.auth.uid == uid` previously let any
    // signed-in account write unlimited documents into
    // users/{their-own-uid}/anything-at-all/. Since sign-up is open to any
    // Google account, that was a free, authenticated, unmetered write target
    // pointed at Jake's Blaze card. Whitelisting the four names the app
    // actually uses costs nothing and removes the collection entirely.
    //
    // Verified against every users/{uid}/... path in game.js, learn.js,
    // index.html, lessons-admin.js and reports.html as of 2026-08-02. If you
    // add a subcollection, add it here or its writes will silently fail.
    // ('stats' is matched by the more specific rule above and never reaches
    // this block, but it is listed for completeness and costs nothing.)
    // ⚠️⚠️ v2.7.0 — ROADMAP 15. BUILDING-SCOPED STAFF MAY WRITE lessonProgress,
    // AND ONLY lessonProgress.
    //
    // reports.html's ⚑ grade-reconstruction button writes runGrades/runFires
    // back onto a STUDENT'S record, and until this version the rule here was
    // `request.auth.uid == uid` with no staff branch at all — so the button
    // would have failed permission-denied for every student except Jake's own
    // account, which is the one account that never needed it.
    //
    // ⚠️ RULE 9: THIS RULE CHANGE SHIPS IN THE SAME ROUND AS THE FEATURE, not
    // after it. "The rules won't let me do it yet, so I'll ship the other half
    // now" is the one sentence every counting incident in this project traces to.
    //
    // ⚠️ THE SCOPE IS DELIBERATELY NARROWER THAN THE READ RULE BELOW. It names
    // lessonProgress explicitly rather than reusing the four-name whitelist:
    // nothing in the app needs staff to write a student's `profile`, `progress`
    // or `stats`, and a wildcard here would hand every teacher a write path to
    // all four. It mirrors the /stats rule above — super, or a staff member who
    // reads the whole building AND is in that student's building.
    match /users/{uid}/{collection}/{docId} {
      allow write: if (request.auth.uid == uid
                       && collection in ['progress', 'profile', 'lessonProgress', 'stats'])
        || (collection == 'lessonProgress'
            && (isSuper()
                || (isStaff() && readsWholeBuilding() && inMySchool(
                      get(/databases/$(database)/documents/users/$(uid)).data.schoolId))));
      allow read: if request.auth.uid == uid
        || isSuper()
        || (isStaff() && inMySchool(
              get(/databases/$(database)/documents/users/$(uid)).data.schoolId));
    }

    // ─────────────────────────── activity logs ───────────────────────────
    //
    // ⚠️ v2.2.0 — WRITE VALIDATION. Everything below used to accept any payload
    // from any signed-in user. Two separate problems, and neither needed an
    // attacker to be clever:
    //
    //   MONEY. Sign-up is open to any Google account on earth (deliberately —
    //   students self-serve and Jake's own son uses it). Combined with an
    //   unvalidated `allow create`, a script could write documents into
    //   typing_sessions until the Blaze bill became somebody's problem. That
    //   somebody is Jake personally. Size limits and field whitelists don't stop
    //   a determined attacker — App Check does, and it is console-only, see
    //   HANDOFF §B.4 — but they cap the damage per document and they cost
    //   nothing.
    //
    //   GRADES. typing_logs is what reports.html grades from, and a student
    //   could write `seconds: 999999` into their own log with two lines in the
    //   console. Middle schoolers absolutely do find this. The clamps below are
    //   generous enough that no honest session can hit them: 86,400 seconds is a
    //   full day, and nobody types 5,000,000 characters.

    // A daily log is bounded by the day it describes. These ceilings are sanity
    // limits, not targets — they exist to make a forged value obviously absurd
    // rather than plausibly high. 86,400 seconds is a full 24 hours.
    //
    // ⚠️ NO keys().hasOnly() HERE, ON PURPOSE. Both writers use setDoc(merge:true),
    // and under a merge `request.resource.data` is the MERGED result, not the
    // delta. A field written by any earlier version of the app that isn't in a
    // whitelist would fail the rule, every flush, forever — and the client
    // catches that failure and logs a console warning, so a student's time would
    // silently stop recording. Silent grade loss is a far worse outcome than the
    // storage a stray field costs. The docId binding below is what actually
    // bounds this collection; a whitelist would only have bounded its width.
    // ⚠️ v2.4.0 — SPLIT-FIELD SHAPE. game.js/learn.js no longer write a shared
    // seconds/chars/mistakes triple — see HANDOFF §0.7/§3: two page controllers
    // writing the SAME field from the SAME document let one mode's flush
    // silently overwrite the other's contribution for the same day. They now
    // write secondsLibrary/charsLibrary/mistakesLibrary (game.js) and
    // secondsSchool/charsSchool/mistakesSchool (learn.js) — disjoint fields, so
    // a merge from either side can never erase the other's. A brand-new
    // document therefore carries ONLY one split triple, not the legacy one; a
    // document a student has used both modes on carries both split triples;
    // and every document written before this shipped still carries the legacy
    // triple, untouched, since a merge never removes a field it doesn't
    // mention. Every one of the six fields, IF PRESENT, must still clear the
    // same bounds as before — this widens what shape is accepted, not what
    // values are.
    function validDailyLog(d) {
      return d.uid is string
          && d.date is string && d.date.size() == 10
          && (!('seconds' in d)         || (d.seconds         is number && d.seconds         >= 0 && d.seconds         <= 86400))
          && (!('chars' in d)           || (d.chars           is number && d.chars           >= 0 && d.chars           <= 5000000))
          && (!('mistakes' in d)        || (d.mistakes        is number && d.mistakes        >= 0 && d.mistakes        <= 5000000))
          && (!('secondsLibrary' in d)  || (d.secondsLibrary  is number && d.secondsLibrary  >= 0 && d.secondsLibrary  <= 86400))
          && (!('charsLibrary' in d)    || (d.charsLibrary    is number && d.charsLibrary    >= 0 && d.charsLibrary    <= 5000000))
          && (!('mistakesLibrary' in d) || (d.mistakesLibrary is number && d.mistakesLibrary >= 0 && d.mistakesLibrary <= 5000000))
          && (!('secondsSchool' in d)   || (d.secondsSchool   is number && d.secondsSchool   >= 0 && d.secondsSchool   <= 86400))
          && (!('charsSchool' in d)     || (d.charsSchool     is number && d.charsSchool     >= 0 && d.charsSchool     <= 5000000))
          && (!('mistakesSchool' in d)  || (d.mistakesSchool  is number && d.mistakesSchool  >= 0 && d.mistakesSchool  <= 5000000))
          // ⚠️ At least one recognized seconds field must exist, or an empty /
          // garbage document (uid + date and nothing else) would otherwise pass
          // every check above by having nothing to violate.
          && ('seconds' in d || 'secondsLibrary' in d || 'secondsSchool' in d);
    }

    // ⚠️ THE DOC ID IS NOW BOUND TO THE DATE FIELD, not merely prefixed by the
    // uid. `docId.split('_')[0] == uid` proved you owned the document but said
    // nothing about how many you could own: `uid_1`, `uid_2`, `uid_3`... were all
    // legal, so this was an unbounded authenticated write target. Requiring
    // docId == uid + '_' + date caps the collection at exactly one document per
    // student per calendar day, which is what the design always assumed.
    //
    // Both writers already build the id this way — game.js flushAll() and
    // learn.js flushStats() — so this is a tightening, not a change.
    match /typing_logs/{docId} {
      // The student, writing their own log.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && validDailyLog(request.resource.data)
                    && docId == request.auth.uid + '_' + request.resource.data.date;

      // ⚠️ FOUND DURING THE v2.2.0 AUDIT — THIS WAS ALREADY BROKEN.
      //
      // reports.html has had a "correct a student's recorded time" feature for
      // several versions. It calls updateDoc() on typing_logs. But the only
      // update rule was `request.resource.data.uid == request.auth.uid`, and
      // under an update `request.resource.data` is the MERGED document — so
      // `uid` is the STUDENT's, never the teacher's. Every correction a teacher
      // ever attempted was denied. Nobody noticed because the failure surfaces
      // as a console error on a rarely-used button.
      //
      // Corrections are limited to building-scoped staff, matching the identical
      // constraint on users/{uid}/stats above: a class-scoped teacher routes
      // corrections through their building admin. The identity fields are pinned
      // — a correction may change the numbers, never whose log it is or which
      // day it describes, which also keeps the docId binding true.
      allow update: if (signedIn()
                        && request.resource.data.uid == request.auth.uid
                        && validDailyLog(request.resource.data)
                        && docId == request.auth.uid + '_' + request.resource.data.date)
                    || (isStaff()
                        && readsWholeBuilding()
                        && canReadActivity(resource.data)
                        && validDailyLog(request.resource.data)
                        && request.resource.data.uid  == resource.data.uid
                        && request.resource.data.date == resource.data.date);

      // ⚠️⚠️⚠️ v2.6.0 — `resource == null` IS FIRST AND IT IS NOT A TIDY-UP.
      // IT IS THE FIX FOR A LIVE, CLASSROOM-WIDE DEFECT. READ THIS BEFORE
      // TOUCHING THE CLAUSE ORDER.
      //
      // On a get() of a document that DOES NOT EXIST, `resource` is null. Both
      // clauses below dereference `resource.data`. Dereferencing null in rules
      // is an evaluation error, an error denies, and so A READ OF A DAY THE
      // STUDENT DID NOT TYPE CAME BACK PERMISSION_DENIED rather than "no
      // document".
      //
      // Why that was catastrophic rather than cosmetic: daylog.js readWeek()
      // reads SEVEN days by id and returns ok:false if ANY of them fails. Every
      // school week contains a Saturday, a Sunday and at least one day that has
      // not happened yet, so EVERY read of EVERY student's week failed, EVERY
      // TIME, from the moment v2.5.0's owner-read shipped. Observed 2026-08-20
      // in a student's console:
      //
      //     [daylog] read failed 2026-08-15 Missing or insufficient permissions.
      //     [daylog] read failed 2026-08-16 Missing or insufficient permissions.
      //     [daylog] read failed 2026-08-21 Missing or insufficient permissions.
      //
      // Two consequences, and the second is the expensive one:
      //
      //   1. loadUserStats() returns early rather than paint a zero, so the HUD
      //      ticks up from zero and a child sees only what they typed in THIS
      //      tab. More than half of one class reported a week equal to their
      //      day. Their real week was in this collection the whole time.
      //   2. ⚠️ THE COUNTER THAT STARTED AT ZERO IS THEN WRITTEN BACK AS THE
      //      ABSOLUTE DAY TOTAL. A student's second page load of a day
      //      overwrote the first. That is data loss, it is not §3.1, and it is
      //      also why "seeding the day total at page load makes sequential use
      //      safe" was never true in production — the seed never arrived.
      //
      // ⚠️ THE ORDER IS COST, NOT STYLE. Both surviving clauses are cheap for a
      // student; canReadActivity() carries a billed get() and stays last. The
      // null test is free and must come FIRST, because the whole point is that
      // nothing after it ever evaluates against a null resource.
      //
      // ⚠️ WHAT `resource == null && signedIn()` DISCLOSES: that a document id
      // does not exist. Ids are `{uid}_{date}` and Firebase uids are unguessable
      // random strings, so a signed-in user learns nothing about a student whose
      // uid they do not already have, and NOTHING WHATEVER about a document that
      // does exist. The alternative — matching the uid out of the doc id — costs
      // a string split in a rule, and clever string handling in this file is how
      // the update rule above stayed silently broken for several versions.
      //
      // ⚠️ QUERIES ARE UNAFFECTED. In a query, `resource` stands for a
      // hypothetical matched document and is never null, so this clause is
      // always false there and reports.html's class queries evaluate exactly as
      // they did in v2.5.0.
      //
      // ⚠️ v2.5.0 — THE OWNER READS THEIR OWN. See this file's header for why
      // this one clause is the hinge the whole two-number problem turns on.
      allow read:   if (signedIn() && resource == null)
                    || (signedIn() && resource.data.uid == request.auth.uid)
                    || canReadActivity(resource.data);
      allow delete: if isSuper();
    }

    // ⚠️ The sprint rollup is the ONLY collection in the app where a client can
    // create an unlimited number of documents. game.js writes at most one per
    // session; nothing legitimate writes hundreds. The field whitelist caps what
    // one forged document can cost in storage, and `sprints` is capped at 200
    // entries — a 30-second sprint for a solid two hours.
    match /typing_sessions/{id} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.seconds is number
                    && request.resource.data.seconds >= 0
                    && request.resource.data.seconds <= 86400
                    && request.resource.data.sprints is list
                    && request.resource.data.sprints.size() <= 200
                    && request.resource.data.expiresAt is timestamp;
      // ⚠️ v2.6.0 — the same null-resource clause as typing_logs above, and it
      // is here PRE-EMPTIVELY: nothing shipped reads this collection by document
      // id today (every reader queries by uid+date, and a query's `resource` is
      // never null), so this collection was not part of the 2026-08-20 incident.
      // It is armed with the identical trap, one getDoc() away from firing, and
      // the two collections are read by the same code on the same page. Leaving
      // the loaded one next to the fixed one is how a known blocker sits in a
      // repository unread for a session. Read typing_logs' note for the full
      // account.
      //
      // ⚠️ practice_sessions below is the third instance of this shape and is
      // deliberately NOT changed: it is staff-query-only, has no by-id reader
      // and no owner-read clause to be broken. If one is ever added, this note
      // is the reason to fix that rule in the same commit.
      //
      // ⚠️ v2.5.0 — THE OWNER READS THEIR OWN, for the same reason as
      // typing_logs above: a client that cannot read the record cannot derive
      // its display from it, and is forced into keeping a second copy. Owner
      // first, so a student's read never triggers a billed get().
      allow read:   if (signedIn() && resource == null)
                    || (signedIn() && resource.data.uid == request.auth.uid)
                    || canReadActivity(resource.data);
      // ⚠️ v2.8.0 — THE OWNER MAY UPDATE, UNDER THE SAME VALIDATION AS
      // create. This is what session-log.js v1.7.0's idempotent flush needs:
      // a resend derives the same document id and setDoc()s it, which is a
      // Firestore UPDATE against an existing document. Before this it was
      // isSuper()-only, so a real resend would be denied and retry forever —
      // see the header note above. The clauses are the create rule's,
      // repeated rather than shared, because `update`'s `resource` is the
      // EXISTING document and `create`'s `resource` is null; a shared
      // function taking both would need the same five checks written twice
      // inside it anyway.
      allow update: if isSuper()
                    || (signedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == request.auth.uid
                        && request.resource.data.seconds is number
                        && request.resource.data.seconds >= 0
                        && request.resource.data.seconds <= 86400
                        && request.resource.data.sprints is list
                        && request.resource.data.sprints.size() <= 200
                        && request.resource.data.expiresAt is timestamp);
      allow delete: if isSuper();
    }

    // These carry email, displayName, and the full generated paragraph, so they
    // get the same scoping as any other activity data (game.js v3.4.2 added the
    // stamps that make that possible). Documents written before v3.4.2 have no
    // stamps and are therefore super_admin-only — the right way round.
    //
    // The generated paragraph is the heaviest payload in the database, so the
    // create rule requires the TTL field. A document without expiresAt would
    // never be collected and would sit in storage forever.
    match /practice_sessions/{id} {
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.generatedText is string
                    && request.resource.data.generatedText.size() <= 4000;
      allow read:   if canReadActivity(resource.data);
      allow update, delete: if isSuper();
    }

    // Written by the generatePractice Cloud Function via the Admin SDK, which
    // bypasses rules. No client should ever touch these.
    match /practice_limits/{uid} {
      allow read, write: if false;
    }

    // ─────────────────────────── leaderboard ───────────────────────────
    // Public to signed-in students by design. Initials only — real names were
    // removed in game.js v3.3.0 precisely because of this rule.
    match /leaderboard/{uid} {
      allow read:   if signedIn();
      allow create, update: if request.auth.uid == uid || isStaff();
      allow delete: if isSuper();
    }

    // ─────────────────────────── staff ───────────────────────────
    // THE SECURITY BOUNDARY OF THE WHOLE APP. Read the constraints carefully
    // before editing: with roles in documents rather than claims, this rule is the
    // only thing stopping someone writing themselves a role.
    match /staff/{uid} {
      // Self first — reading your own record shouldn't cost a get() to prove
      // you're staff when you might not be.
      allow read: if request.auth.uid == uid || isStaff();

      // Claiming a pre-authorised role on first sign-in. The pendingStaffRoles
      // document was written by an admin; all this does is copy it onto the
      // person's UID, unchanged. They can't alter it afterwards.
      allow create, update: if request.auth.uid == uid && matchesPendingRole();

      // Nobody otherwise edits their own record. Not even a super_admin — that's
      // what stops an admin quietly widening their own reach, and it's why
      // granting the FIRST super_admin has to happen in the Firebase console.
      allow create, update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.role in ['teacher', 'building_admin', 'super_admin']
        && request.resource.data.schoolIds is list
        && request.resource.data.schoolIds.size() > 0
        && request.resource.data.readScope in ['own_classes', 'building']
        // Only a super_admin may mint another admin. A building_admin makes
        // teachers, and only inside their own building(s).
        && (isSuper() || (
             request.resource.data.role == 'teacher'
             && request.resource.data.schoolIds.hasOnly(mySchools())
             // ...and may not reassign someone out of their building.
             && (!exists(/databases/$(database)/documents/staff/$(uid))
                 || get(/databases/$(database)/documents/staff/$(uid)).data.role == 'teacher')
           ));

      allow delete: if isSuper() && request.auth.uid != uid;
    }

    // Roles granted to an email address, for people who may not have signed in
    // yet. Written by admins; consumed by the person on their first sign-in.
    match /pendingStaffRoles/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      // A building_admin may pre-authorise teachers, in their own building only.
      allow create, update: if isSuper()
        || (isBldgAdmin()
            && request.resource.data.role == 'teacher'
            && request.resource.data.schoolIds is list
            && request.resource.data.schoolIds.size() > 0
            && request.resource.data.schoolIds.hasOnly(mySchools())
            && request.resource.data.readScope in ['own_classes', 'building']);
      // The owner deletes it once claimed.
      allow delete: if isAdmin() || (signedIn() && request.auth.token.email == email);
    }

    // A colleague asks for access by writing their own request. This is how the
    // Staff tab finds people WITHOUT a browsable directory of every user: only
    // people who opted in by asking ever appear.
    match /staffRequests/{uid} {
      allow create: if request.auth.uid == uid
                    && request.resource.data.uid == request.auth.uid;
      allow read, delete: if request.auth.uid == uid || isAdmin();
      allow update: if request.auth.uid == uid;
    }

    // ─────────────────────────── org structure ───────────────────────────
    // Buildings. super_admin only, but that's a ROLE check, not a "console only"
    // limitation — a super_admin can create these straight from the Schools panel
    // on admin.html. The only genuinely console-only thing in this whole system is
    // the FIRST super_admin record, because rules require an existing admin to
    // create staff records and nobody may edit their own.
    match /schools/{schoolId} {
      allow read:  if signedIn();          // students need their building's name
      allow write: if isSuper();
    }

    match /classes/{classId} {
      allow read: if signedIn();           // students read their own class goals

      // Creating: in your building, and you must put yourself on it — otherwise
      // you'd make a class you can't then read.
      allow create: if (isSuper() && request.resource.data.schoolId is string)
                    || (isBldgAdmin() && inMySchool(request.resource.data.schoolId))
                    || (isStaff()
                        && inMySchool(request.resource.data.schoolId)
                        && request.resource.data.teacherUids is list
                        && request.auth.uid in request.resource.data.teacherUids);

      // Updating: a building_admin edits any class in their building. A plain
      // teacher edits only classes already in their own classIds — otherwise
      // adding yourself to a colleague's class would be a self-service way to
      // widen your own read scope.
      allow update: if isSuper()
                    || (isBldgAdmin() && inMySchool(resource.data.schoolId)
                                      && inMySchool(request.resource.data.schoolId))
                    // Already on the class. Since update REQUIRES being on it,
                    // there's no way to add yourself to a colleague's class.
                    || (isStaff() && resource.data.teacherUids is list
                                  && request.auth.uid in resource.data.teacherUids
                                  && inMySchool(resource.data.schoolId)
                                  && inMySchool(request.resource.data.schoolId));

      allow delete: if isSuper()
                    || (isBldgAdmin() && inMySchool(resource.data.schoolId))
                    || (isStaff() && resource.data.teacherUids is list
                                  && request.auth.uid in resource.data.teacherUids
                                  && inMySchool(resource.data.schoolId));
    }

    // Roster pre-assignment: keyed by student email, consumed by the student on
    // first sign-in (learn.js applyPendingClassAssignment deletes it as the
    // student, which is why delete is allowed to the owner).
    match /pendingClassAssignments/{email} {
      // Owner first: every student checks this on sign-in, and isStaff() would
      // cost them a get() to establish they aren't staff.
      allow read, delete: if (signedIn() && request.auth.token.email == email)
                             || isStaff();
      allow create, update: if isStaff();
    }

    // ─────────────────────────── content ───────────────────────────
    //
    // ⚠️ `if true` HERE IS THE WHOLE GUEST FEATURE (v2.3.0). A student who has
    // not signed in can read the library, open a book, type a chapter, and work
    // through the lessons. Nothing about writing changed: progress, typing_logs,
    // stats and the leaderboard all still require `request.auth.uid == uid`, so
    // a guest's work is genuinely untracked rather than tracked to a placeholder.
    //
    // ⚠️ THIS IS ALSO WHY THE LIBRARY NEEDED A REFRESH TO APPEAR. index.html
    // calls loadBooks() at module load, before auth has resolved, and
    // onAuthStateChanged only re-renders — it never re-loads. So the first read
    // went out unauthenticated, was denied, and the empty grid it produced
    // survived sign-in. A second page load had a persisted session by the time
    // Firestore asked, so it worked. Same shape in learn.js, whose loadLessons()
    // carries a comment claiming this collection is already public.
    //
    // Licence check, because this publishes the text: everything in the library
    // is US public domain or Creative Commons (see admin.html's rights
    // dropdown — PD, CC BY, CC BY-SA, CC BY-NC, CC BY-NC-SA). Every one of those
    // permits public display. There is no classroom-only licensed text in here;
    // the classroom-edition path was removed in admin.js v3.30.0. ⚠️ If a
    // classroom-licensed or otherwise restricted title is ever added, THIS RULE
    // is what has to change, and nothing in the app will remind you.
    match /books/{bookId} {
      allow read:  if true;
      allow write: if isSuper();
      match /chapters/{chapterId} {
        allow read:  if true;
        allow write: if isSuper();
      }
    }

    match /lessons/{lessonId} {
      allow read:  if true;
      allow write: if isSuper();
    }

    // ⚠️ KEYED ON THE DOCUMENT ID ON PURPOSE — do not collapse this back to a
    // single condition. settings/goals is the class minute target and every
    // student reads it, guest or not. settings/languageFilter is the curated
    // flagged-word list; it stays behind auth because publishing a list of
    // slurs and profanity to the open internet is a bad outcome with no upside,
    // and admin.js is its only reader anyway.
    //
    // A new settings document defaults to signed-in-only, which is the right
    // default: if a future document needs to be guest-readable, adding its id
    // here is a deliberate act.
    match /settings/{docId} {
      allow read:  if docId == 'goals' || signedIn();
      allow write: if isSuper();
    }

    // ─────────────────────────── default deny ───────────────────────────
    // Firestore already denies anything no rule allows, so this grants nothing
    // new — rules are permissive-OR and a catch-all `if false` cannot override an
    // allow above. It's documentation: adding a collection means adding a rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
